{
  "name": "gpx2real",
  "version": "0.1.0",
  "description": "Create 3D objects from GPX tracks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:track": "node --import ./scripts/register-ts.mjs scripts/verify-track-drape.ts",
    "verify:corridor": "node --import ./scripts/register-ts.mjs scripts/verify-corridor.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.4.5",
    "vite": "^6.4.3"
  }
}
